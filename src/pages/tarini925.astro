---
// src/pages/tarini925.astro
import Layout from "../layouts/Layout.astro";

const categories = [
  { name: "Rings", image: "/tarini-rings.jpg" },
  { name: "Bracelets", image: "/tarini-bracelets.jpg" },
  { name: "Necklaces", image: "/tarini-necklaces.jpg" }
];
---

<Layout
  title="Tarini925"
  description="Modern silver, timeless you. Kesar's own 925 silver jewellery brand."
>
  <!-- 1. HERO SECTION (Dark per wireframe) -->
  <section class="relative flex min-h-[85vh] items-center justify-center overflow-hidden bg-ink text-center">
    <div class="absolute inset-0">
      <!-- Save as "tarini-hero-bg.jpg" -->
      <img src="/tarini-hero-bg.jpg" alt="Tarini925 Silver Jewellery" class="w-full h-full object-cover opacity-50 mix-blend-luminosity" />
      <div class="absolute inset-0 bg-ink/40"></div>
    </div>
    
    <div class="relative z-10 mx-auto max-w-4xl px-6 pt-10">
      <h1 class="animate-rise font-display text-5xl md:text-7xl tracking-wide text-ivory leading-[1.1]">
        TARINI925
      </h1>
      <p class="animate-rise mt-4 font-display text-2xl md:text-3xl text-ivory/90" style="animation-delay: 100ms;">
        MODERN SILVER. TIMELESS YOU.
      </p>
      <p class="animate-rise mt-6 font-body text-[11px] font-semibold tracking-[0.2em] text-gold-soft uppercase" style="animation-delay: 200ms;">
        925 Silver Jewellery
      </p>
      <div class="animate-rise mt-10" style="animation-delay: 300ms;">
        <a href="#collection" class="inline-block border border-ivory/30 px-8 py-3.5 font-body text-xs font-semibold uppercase tracking-widest text-ivory hover:bg-ivory hover:text-ink transition-colors">
          Explore Collection
        </a>
      </div>
    </div>
  </section>

  <!-- 2. OUR COLLECTION -->
  <section id="collection" class="bg-ivory py-24 text-center">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-16">
        Our Collection
      </h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 md:gap-12">
        {categories.map((category) => (
          <div class="group flex flex-col items-center cursor-pointer">
            <div class="w-full aspect-[4/5] bg-sand overflow-hidden border border-hairline mb-6">
              <!-- Images should be saved as tarini-rings.jpg, tarini-bracelets.jpg, tarini-necklaces.jpg -->
              <img 
                src={category.image} 
                alt={category.name} 
                class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" 
              />
            </div>
            <h3 class="font-display text-2xl text-ink transition-colors group-hover:text-gold-deep">{category.name}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. THE ESSENCE -->
  <section class="bg-sand py-24 border-t border-hairline">
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-8">
          The Essence
        </h2>
        <p class="font-body text-sm leading-relaxed text-ink/70 mb-4">
          Tarini925 brings the exacting standards of luxury watchmaking to everyday silver jewellery. We treat 925 sterling silver with the respect it deserves, applying rigorous polishing, precise casting, and architectural design principles to every piece.
        </p>
        <p class="font-body text-sm leading-relaxed text-ink/70">
          Designed for the modern wearer, the collection balances bold geometric forms with delicate, timeless wearability.
        </p>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <!-- Save as "tarini-essence-1.jpg" and "tarini-essence-2.jpg" -->
        <div class="aspect-[3/4] bg-ivory overflow-hidden border border-hairline group mt-8">
          <img src="/tarini-essence-1.jpg" alt="Jewellery Detail" class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" />
        </div>
        <div class="aspect-[3/4] bg-ivory overflow-hidden border border-hairline group mb-8">
          <img src="/tarini-essence-2.jpg" alt="Jewellery Lifestyle" class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. BOTTOM CTA WITH EXTERNAL LINK -->
  <section class="bg-ivory py-32 text-center border-t border-hairline">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display text-4xl md:text-5xl text-ink tracking-widest uppercase">
        EVERY PIECE A STORY.
      </h2>
      <a 
        href="https://tarini925.com/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="mt-10 inline-block border border-ink bg-transparent px-10 py-4 font-body text-[11px] font-semibold uppercase tracking-[0.2em] text-ink hover:bg-ink hover:text-ivory transition-colors"
      >
        Visit tarini925.com &nearr;
      </a>
    </div>
  </section>
</Layout>