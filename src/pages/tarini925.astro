---
import Layout from "../layouts/Layout.astro";

const categories = [
  { name: "Rings", image: "/tarini-rings.jpg" },
  { name: "Earrings", image: "/tarini-earrings.jpg" }
];
---

<Layout
  title="Tarini925"
  description="Modern silver, timeless you. Kesar's own 925 silver jewellery brand."
>
  <!-- 1. HERO SECTION — SAME STYLE AS AEVUM -->
  <section class="tarini-hero">
    <!-- Full-screen background -->
    <img
      src="/tarini-hero-bg.jpg"
      alt="Tarini925 silver jewellery"
      fetchpriority="high"
      class="tarini-hero-background"
    />

    <!-- Dark overlay -->
    <div class="tarini-hero-overlay"></div>

    <!-- Gradient matching Aevum -->
    <div class="tarini-hero-gradient"></div>

    <!-- Left-aligned content matching Aevum -->
    <div class="tarini-hero-container">
      <div class="tarini-hero-copy">
        <h1 class="animate-rise font-display">
          TARINI925
        </h1>

        <p
          class="tarini-tagline animate-rise font-display"
          style="animation-delay: 100ms;"
        >
          MODERN SILVER. TIMELESS YOU.
        </p>

        <p
          class="tarini-subtitle animate-rise font-body"
          style="animation-delay: 200ms;"
        >
          925 SILVER JEWELLERY
        </p>

        <div
          class="tarini-button-wrap animate-rise"
          style="animation-delay: 300ms;"
        >
          <a href="#collection" class="tarini-button font-body">
            EXPLORE COLLECTION
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. OUR COLLECTION -->
  <section id="collection" class="bg-ivory py-24 text-center">
    <div class="mx-auto max-w-5xl px-6">
      <h2
        class="mb-16 border-b border-hairline pb-4 font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50"
      >
        Our Collection
      </h2>

      <!-- Balanced 2-column layout for Rings and Earrings -->
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:gap-16 max-w-3xl mx-auto">
        {categories.map((category) => (
          <div class="group flex cursor-pointer flex-col items-center">
            <div class="mb-6 aspect-[4/5] w-full overflow-hidden border border-hairline bg-sand">
              <img
                src={category.image}
                alt={category.name}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>

            <h3 class="font-display text-2xl text-ink transition-colors group-hover:text-gold-deep">
              {category.name}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. THE ESSENCE -->
  <section class="border-t border-hairline bg-sand py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <h2
          class="mb-8 border-b border-hairline pb-4 font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50"
        >
          The Essence
        </h2>

        <p class="mb-6 font-body text-base leading-relaxed text-ink/70 md:text-lg">
          Tarini925 brings the exacting standards of luxury watchmaking to
          everyday silver jewellery. We treat 925 sterling silver with the
          respect it deserves, applying rigorous polishing, precise casting,
          and architectural design principles to every piece.
        </p>

        <p class="font-body text-base leading-relaxed text-ink/70 md:text-lg">
          Designed for the modern wearer, the collection balances bold
          geometric forms with delicate, timeless wearability.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="group mt-8 aspect-[3/4] overflow-hidden border border-hairline bg-ivory">
          <img
            src="/tarini-essence-1.jpg"
            alt="Tarini925 jewellery detail"
            loading="lazy"
            class="h-full w-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />
        </div>

        <div class="group mb-8 aspect-[3/4] overflow-hidden border border-hairline bg-ivory">
          <img
            src="/tarini-essence-2.jpg"
            alt="Tarini925 jewellery lifestyle"
            loading="lazy"
            class="h-full w-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 4. BOTTOM CTA -->
  <section class="border-t border-hairline bg-ivory py-32 text-center">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-display text-4xl uppercase tracking-widest text-ink md:text-5xl">
        EVERY PIECE A STORY.
      </h2>

      <a
        href="https://tarini925.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-10 inline-block border border-ink bg-transparent px-10 py-4 font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink transition-colors hover:bg-ink hover:text-ivory"
      >
        Visit tarini925.com ↗
      </a>
    </div>
  </section>

  <!-- HERO STYLES — MATCH AEVUM -->
  <style>
    .tarini-hero {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: center;
      min-height: calc(100svh - 124px);
      overflow: hidden;
      background: #080808;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .tarini-hero-background {
      position: absolute;
      inset: 0;
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .tarini-hero-overlay {
      position: absolute;
      inset: 0;
      z-index: -2;
      background: rgba(0, 0, 0, 0.35);
      pointer-events: none;
    }

    .tarini-hero-gradient {
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.85) 0%,
        rgba(0, 0, 0, 0.55) 42%,
        rgba(0, 0, 0, 0.12) 100%
      );
      pointer-events: none;
    }

    .tarini-hero-container {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 100px 48px;
    }

    .tarini-hero-copy {
      max-width: 720px;
    }

    .tarini-hero-copy h1 {
      margin: 0;
      color: #fff;
      font-size: clamp(3.5rem, 7vw, 6rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 0.06em;
    }

    .tarini-tagline {
      margin-top: 20px;
      color: rgba(255, 255, 255, 0.9);
      font-size: clamp(1.25rem, 2.6vw, 2rem);
      line-height: 1.3;
    }

    .tarini-subtitle {
      margin-top: 24px;
      color: #d7bd80;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .tarini-button-wrap {
      margin-top: 40px;
    }

    .tarini-button {
      display: inline-block;
      padding: 15px 32px;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #fff;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-decoration: none;
      transition:
        color 0.3s ease,
        background-color 0.3s ease,
        border-color 0.3s ease;
    }

    .tarini-button:hover {
      color: #080808;
      background: #fff;
      border-color: #fff;
    }

    @media (max-width: 767px) {
      .tarini-hero {
        min-height: calc(100svh - 124px);
      }

      .tarini-hero-background {
        object-position: 60% center;
      }

      .tarini-hero-gradient {
        background: linear-gradient(
          90deg,
          rgba(0, 0, 0, 0.8),
          rgba(0, 0, 0, 0.35)
        );
      }

      .tarini-hero-container {
        padding: 80px 24px;
      }

      .tarini-hero-copy h1 {
        font-size: clamp(3rem, 12vw, 4.5rem);
      }

      .tarini-tagline {
        max-width: 420px;
      }

      .tarini-subtitle {
        font-size: 0.75rem;
        line-height: 1.8;
      }
    }
  </style>
</Layout>