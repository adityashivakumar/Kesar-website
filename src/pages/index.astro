---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { capabilities, materials } from "../lib/content";
---

<Layout
  title="Kesar"
  description="Precious-metal watchmaking and product development."
>
  <!-- 01. HERO -->
  <section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-ink text-center">
    <div class="absolute inset-0 z-0 bg-ink">
      <img src="/hero-1.jpg" alt="Kesar Watchmaking" class="hero-banner absolute inset-0 h-full w-full object-cover opacity-50 transition-opacity duration-1000" />
      <img src="/hero-2.jpg" alt="Precision Craft" class="hero-banner absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000" />
      <img src="/hero-3.jpg" alt="Luxury Details" class="hero-banner absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000" />
      <div class="absolute inset-0 bg-ink/40 z-10"></div>
    </div>

    <div class="relative z-20 mx-auto max-w-4xl px-6">
      <h1 class="animate-rise font-display text-5xl leading-[1.1] text-ivory md:text-7xl">
        PRECIOUS METAL.<br />TIMELESS CRAFT.
      </h1>
      <p class="animate-rise mt-6 font-body text-sm md:text-base tracking-[0.2em] text-ivory/80 uppercase" style="animation-delay: 100ms;">
        Watchmaking & Product Development
      </p>
      <div class="animate-rise mt-10 flex flex-wrap justify-center gap-4" style="animation-delay: 200ms;">
        <a href="/precious-metal" class="border border-ivory/30 bg-ink/50 backdrop-blur-sm px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-wider text-ivory hover:bg-ivory hover:text-ink transition-colors">
          Explore Kesar
        </a>
        <a href="/start-a-project" class="bg-ivory px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-wider text-ink hover:bg-gold transition-colors">
          Start a Project
        </a>
      </div>
    </div>
  </section>

  <!-- 02. THE MATERIAL -->
  <section class="bg-ivory py-32 text-center">
    <div class="mx-auto w-full px-6 md:px-12 lg:px-16">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50">The Material</h2>
      <p class="mx-auto mt-6 max-w-2xl font-display text-3xl text-ink md:text-4xl">
        PRECIOUS METAL IS NOT AN ACCENT.<br/>IT IS THE TIMEPIECE.
      </p>
      
      <div class="mt-20 grid grid-cols-1 gap-10 md:gap-16 md:grid-cols-2">
        {materials.map((m) => (
          <div class="text-center group">
            <div class="relative aspect-video overflow-hidden rounded-sm bg-sand">
              <img src={`/material-${m.key}.jpg`} alt={m.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <h3 class="mt-8 font-display text-3xl text-ink uppercase tracking-wide">{m.name}</h3>
            <p class="mt-3 font-body text-sm tracking-widest text-gold-deep uppercase">{m.words.join(" · ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03. MORE THAN A WATCH MANUFACTURER (Bleed Layout) -->
  <section class="relative bg-sand overflow-hidden flex items-center min-h-[70vh]">
    <div class="mx-auto w-full max-w-7xl px-6 relative z-10 grid md:grid-cols-2 py-32">
      <div class="md:pr-12 lg:pr-20">
        <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50">More than a watch manufacturer.</h2>
        <p class="mt-6 font-display text-4xl leading-tight text-ink md:text-5xl">
          Kesar spans design, components, and assembly for premium timepieces.
        </p>
        <p class="mt-8 font-body text-base md:text-lg leading-relaxed text-ink/70">
          We are a B2B watchmaking and product-development company with a strong focus on gold, silver and precious-metal timepieces — from early idea to finished delivery.
        </p>
        <a href="/about" class="mt-12 inline-block bg-ink px-8 py-4 font-body text-sm font-semibold uppercase tracking-wider text-ivory hover:bg-gold transition-colors">
          Discover Kesar
        </a>
      </div>
    </div>
    <div class="relative w-full aspect-video md:aspect-auto md:absolute md:top-0 md:right-0 md:bottom-0 md:w-[48vw] lg:w-[50vw] shadow-2xl z-20">
      <img src="/workshop.jpg" alt="Watchmaking Craftsmanship" class="h-full w-full object-cover" />
    </div>
  </section>

  <!-- 05. EXPLORE THE PROCESS -->
  <section class="bg-sand py-32 border-t border-hairline overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50 mb-4">Explore Kesar</h2>
      <p class="font-display text-4xl text-ink mb-20">THE WATCHMAKING LIFECYCLE</p>
      
      <div class="relative w-full max-w-[320px] sm:max-w-[450px] md:max-w-[550px] mx-auto aspect-square rounded-full border border-hairline flex items-center justify-center p-8 md:p-12 shadow-[inset_0_0_50px_rgba(0,0,0,0.03)] bg-ivory">
        <div class="relative z-10 text-center bg-ivory/95 backdrop-blur-sm p-6 md:p-10 rounded-full aspect-square flex flex-col justify-center items-center w-[75%] max-w-[350px] border border-hairline shadow-xl transition-all duration-500" id="chart-content">
          <p class="font-body text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-gold-deep mb-3" id="chart-step">Phase 01</p>
          <h3 class="font-display text-2xl md:text-3xl text-ink mb-3" id="chart-title">Concept & Brief</h3>
          <p class="font-body text-sm md:text-base leading-relaxed text-ink/70 line-clamp-4 md:line-clamp-none" id="chart-desc">
            Every great timepiece starts with a conversation. We work closely with your team to understand the vision, target market, material requirements, and technical specifications.
          </p>
        </div>

        <div class="absolute inset-0 rounded-full overflow-hidden z-0 p-3 pointer-events-none">
           <img id="chart-bg" src="/process-1.jpg" alt="" class="w-full h-full object-cover rounded-full opacity-20 grayscale mix-blend-multiply transition-opacity duration-500" />
        </div>

        <button class="chart-btn absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-12 h-12 md:w-16 md:h-16 rounded-full bg-ink text-ivory border-4 border-ivory flex items-center justify-center hover:bg-gold hover:text-ink transition-all shadow-lg z-20 focus:outline-none"
                data-step="Phase 01" 
                data-title="Concept & Brief" 
                data-desc="Every great timepiece starts with a conversation. We work closely with your team to understand the vision, target market, material requirements, and technical specifications." 
                data-img="/process-1.jpg">
          <span class="font-display text-base md:text-lg">1</span>
        </button>

        <button class="chart-btn absolute top-1/2 right-0 translate-x-1/2 -translate-y-1/2 w-12 h-12 md:w-16 md:h-16 rounded-full bg-ivory text-ink border-4 border-ivory flex items-center justify-center hover:bg-gold transition-all shadow-md z-20 focus:outline-none"
                data-step="Phase 02" 
                data-title="Development & CAD" 
                data-desc="Translating the initial brief into detailed aesthetic concepts and functional blueprints. We explore case geometry, dial layout, and specify exact tolerances." 
                data-img="/process-2.jpg">
          <span class="font-display text-base md:text-lg">2</span>
        </button>

        <button class="chart-btn absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-12 h-12 md:w-16 md:h-16 rounded-full bg-ivory text-ink border-4 border-ivory flex items-center justify-center hover:bg-gold transition-all shadow-md z-20 focus:outline-none"
                data-step="Phase 03" 
                data-title="Manufacturing" 
                data-desc="Our specialized facility begins the meticulous process of machining, casting, and finishing the precious metal cases while sourcing the exact components." 
                data-img="/process-3.jpg">
          <span class="font-display text-base md:text-lg">3</span>
        </button>

        <button class="chart-btn absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 w-12 h-12 md:w-16 md:h-16 rounded-full bg-ivory text-ink border-4 border-ivory flex items-center justify-center hover:bg-gold transition-all shadow-md z-20 focus:outline-none"
                data-step="Phase 04" 
                data-title="Assembly & QC" 
                data-desc="Master watchmakers assemble timepieces in a dust-free environment. Every watch undergoes rigorous multi-stage quality control for accuracy and finishing." 
                data-img="/process-4.jpg">
          <span class="font-display text-base md:text-lg">4</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 06. OUR CAPABILITIES -->
  <section class="bg-ivory py-32 text-center border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50 mb-20">Our Capabilities</h2>
      <div class="grid grid-cols-1 gap-y-20 gap-x-12 sm:grid-cols-2 md:grid-cols-3">
        {capabilities.slice(0, 6).map((cap) => (
          <div class="flex flex-col items-center">
            <div class="mb-8 flex h-14 w-14 items-center justify-center rounded-full border border-hairline bg-transparent">
              <div class="h-1.5 w-1.5 rounded-full bg-gold-soft"></div>
            </div>
            <h3 class="font-body text-sm font-semibold uppercase tracking-[0.15em] text-ink">{cap.title}</h3>
            <p class="mt-4 max-w-[240px] font-body text-base leading-relaxed text-ink/70">{cap.short}</p>
          </div>
        ))}
      </div>
      <a href="/capabilities" class="mt-24 inline-block border border-ink bg-transparent px-10 py-4 font-body text-sm font-semibold uppercase tracking-widest text-ink hover:bg-ink hover:text-ivory transition-colors">
        View All Capabilities
      </a>
    </div>
  </section>

  <!-- 08. BRANDS -->
  <section class="bg-ivory">
    <div class="grid md:grid-cols-2">
      <!-- Aevum -->
      <div class="relative flex min-h-[500px] flex-col items-center justify-center overflow-hidden bg-ink p-12 text-center text-ivory">
        <div class="absolute inset-0 opacity-40">
           <img src="/aevum-bg.jpg" alt="Aevum" class="w-full h-full object-cover" />
        </div>
        <div class="relative z-10">
          <h3 class="font-display text-5xl tracking-wide">AEVUM</h3>
          <p class="mt-3 font-body text-sm uppercase tracking-[0.2em] text-gold-soft">Gold & Silver Timepieces</p>
          <a href="/our-brands/aevum" class="mt-10 inline-block border border-ivory/50 px-8 py-3 font-body text-sm uppercase tracking-widest hover:bg-ivory hover:text-ink transition-colors">Explore Aevum</a>
        </div>
      </div>
      
      <!-- Tarini925 -->
      <div class="relative flex min-h-[500px] flex-col items-center justify-center overflow-hidden bg-ink p-12 text-center text-ivory border-l border-hairline">
        <div class="absolute inset-0 opacity-40">
           <img src="/tarini-bg.jpg" alt="Tarini925" class="w-full h-full object-cover" />
        </div>
        <div class="relative z-10">
          <h3 class="font-display text-5xl tracking-wide">TARINI925</h3>
          <p class="mt-3 font-body text-sm uppercase tracking-[0.2em] text-ivory/70">925 Silver Jewellery</p>
          <a href="/tarini925" class="mt-10 inline-block border border-ivory/50 px-8 py-3 font-body text-sm uppercase tracking-widest hover:bg-ivory hover:text-ink transition-colors">Explore Tarini925</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 09. SELECTED PROJECTS -->
  <section class="bg-sand py-24 text-center border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink/50">Selected Projects</h2>
      <div class="mt-12 grid grid-cols-3 gap-4 md:gap-8">
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-1.jpg" alt="" class="w-full h-full object-cover"/></div>
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-2.jpg" alt="" class="w-full h-full object-cover"/></div>
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-3.jpg" alt="" class="w-full h-full object-cover"/></div>
      </div>
    </div>
  </section>

  <!-- 10. FINAL CTA -->
  <section class="bg-ink py-32 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-display text-3xl leading-[1.2] text-ivory md:text-5xl">
        HAVE A TIMEPIECE IN MIND?<br/>LET'S TURN IT INTO REALITY.
      </h2>
      <a href="/start-a-project" class="mt-12 inline-block border border-gold bg-transparent px-10 py-4 font-body text-sm font-semibold uppercase tracking-[0.2em] text-ivory hover:bg-gold hover:text-ink transition-colors">
        Start a Project
      </a>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Banner Transition Script
    const banners = document.querySelectorAll('.hero-banner');
    let currentIndex = 0;

    if (banners.length > 1) {
      setInterval(() => {
        banners[currentIndex].classList.remove('opacity-50');
        banners[currentIndex].classList.add('opacity-0');
        currentIndex = (currentIndex + 1) % banners.length;
        banners[currentIndex].classList.remove('opacity-0');
        banners[currentIndex].classList.add('opacity-50');
      }, 4500); 
    }

    // 2. Round Chart Interactivity Script
    const buttons = document.querySelectorAll('.chart-btn');
    const chartBg = document.getElementById('chart-bg') as HTMLImageElement;
    const chartStep = document.getElementById('chart-step');
    const chartTitle = document.getElementById('chart-title');
    const chartDesc = document.getElementById('chart-desc');
    const chartContent = document.getElementById('chart-content');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => {
          b.classList.remove('bg-ink', 'text-ivory');
          b.classList.add('bg-ivory', 'text-ink');
        });

        btn.classList.remove('bg-ivory', 'text-ink');
        btn.classList.add('bg-ink', 'text-ivory');

        if(chartContent && chartBg) {
          chartContent.style.opacity = '0';
          chartBg.style.opacity = '0';

          setTimeout(() => {
            if(chartStep) chartStep.textContent = btn.getAttribute('data-step');
            if(chartTitle) chartTitle.textContent = btn.getAttribute('data-title');
            if(chartDesc) chartDesc.textContent = btn.getAttribute('data-desc');
            
            const newImg = btn.getAttribute('data-img');
            if(newImg) chartBg.src = newImg;

            chartContent.style.opacity = '1';
            chartBg.style.opacity = '0.2'; 
          }, 300);
        }
      });
    });
  });
</script>