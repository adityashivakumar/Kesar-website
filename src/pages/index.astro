---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { capabilities, processSteps, materials } from "../lib/content";
---

<Layout
  title="Kesar"
  description="Precious-metal watchmaking and product development."
>
  <!-- 01. HERO (Dark overlay per wireframe) -->
  <section class="relative flex min-h-[90vh] items-center justify-center overflow-hidden bg-ink text-center">
    <div class="absolute inset-0">
      <!-- Save your main hero image as "hero-bg.jpg" in the public folder -->
      <img src="/hero-bg.jpg" alt="Gold Watch Detail" class="h-full w-full object-cover opacity-50" />
      <div class="absolute inset-0 bg-ink/40"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-6">
      <h1 class="animate-rise font-display text-5xl leading-[1.1] text-ivory md:text-7xl">
        PRECIOUS METAL.<br />TIMELESS CRAFT.
      </h1>
      <p class="animate-rise mt-6 font-body text-xs tracking-[0.2em] text-ivory/80 uppercase" style="animation-delay: 100ms;">
        Watchmaking & Product Development
      </p>
      <div class="animate-rise mt-10 flex flex-wrap justify-center gap-4" style="animation-delay: 200ms;">
        <a href="/precious-metal" class="border border-ivory/30 bg-ink/50 backdrop-blur-sm px-8 py-3.5 font-body text-xs font-semibold uppercase tracking-wider text-ivory hover:bg-ivory hover:text-ink transition-colors">
          Explore Kesar
        </a>
        <a href="/start-a-project" class="bg-ivory px-8 py-3.5 font-body text-xs font-semibold uppercase tracking-wider text-ink hover:bg-gold transition-colors">
          Start a Project
        </a>
      </div>
    </div>
  </section>

  <!-- 02. THE MATERIAL -->
  <section class="bg-ivory py-24 text-center">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">The Material</h2>
      <p class="mx-auto mt-6 max-w-2xl font-display text-3xl text-ink md:text-4xl">
        PRECIOUS METAL IS NOT AN ACCENT.<br/>IT IS THE TIMEPIECE.
      </p>
      
      <div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2">
        {materials.map((m) => (
          <div class="text-center group">
            <div class="relative aspect-[4/3] overflow-hidden rounded-sm bg-sand">
              <!-- Save as "material-gold.jpg" and "material-silver.jpg" -->
              <img src={`/material-${m.key}.jpg`} alt={m.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
            <h3 class="mt-6 font-display text-2xl text-ink uppercase tracking-wide">{m.name}</h3>
            <p class="mt-2 font-body text-xs tracking-widest text-gold-deep uppercase">{m.words.join(" · ")}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03. MORE THAN A WATCH MANUFACTURER -->
  <section class="bg-sand py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">More than a watch manufacturer.</h2>
        <p class="mt-6 font-display text-3xl leading-tight text-ink md:text-4xl">
          Kesar spans design, components, and assembly for premium timepieces.
        </p>
        <p class="mt-6 font-body text-sm leading-relaxed text-ink/70">
          We are a B2B watchmaking and product-development company with a strong focus on gold, silver and precious-metal timepieces — from early idea to finished delivery.
        </p>
        <a href="/about" class="mt-10 inline-block bg-ink px-8 py-3.5 font-body text-xs font-semibold uppercase tracking-wider text-ivory hover:bg-gold transition-colors">
          Discover Kesar
        </a>
      </div>
      <div class="relative aspect-square overflow-hidden rounded-sm bg-ivory">
        <!-- Save as "workshop.jpg" -->
        <img src="/workshop.jpg" alt="Watchmaking Craftsmanship" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <!-- 04. PRECISION IS HUMAN -->
  <section class="bg-ivory py-24 text-center border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Precision is human.</h2>
      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-8">
        {["Touch", "Form", "Precision", "Perfection"].map((label, index) => (
          <div class="group">
            <div class="aspect-square overflow-hidden bg-sand rounded-sm">
              <!-- Save as "precision-1.jpg", "precision-2.jpg", etc. -->
              <img src={`/precision-${index + 1}.jpg`} alt={label} class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105" />
            </div>
            <p class="mt-4 font-body text-xs uppercase tracking-widest text-ink">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05. FROM IDEA TO TIMEPIECE -->
  <section class="bg-sand py-24 text-center border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">From idea to timepiece</h2>
      
      <!-- Linear Timeline Design -->
      <div class="mt-16 relative flex justify-between items-center max-w-4xl mx-auto">
        <!-- Connecting Line -->
        <div class="absolute top-6 left-0 right-0 h-[1px] bg-hairline -z-10"></div>
        
        {processSteps.slice(0, 4).map((step) => (
          <div class="flex flex-col items-center bg-sand px-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full border border-ink bg-ivory font-display text-lg text-ink">
              {step.index}
            </div>
            <p class="mt-4 font-body text-xs font-semibold uppercase tracking-widest text-ink">{step.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06. OUR CAPABILITIES -->
  <section class="bg-ivory py-24 text-center">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Our Capabilities</h2>
      <div class="mt-16 grid grid-cols-2 gap-y-16 gap-x-8 md:grid-cols-3">
        {capabilities.slice(0, 6).map((cap) => (
          <a href={`/capabilities/${cap.slug}`} class="group flex flex-col items-center">
            <!-- Save corresponding icons as "icon-design.svg", etc. or use a simple CSS circle for now -->
            <div class="flex h-16 w-16 items-center justify-center rounded-full border border-hairline bg-sand transition-colors group-hover:border-gold">
               <span class="font-display text-xl text-ink/30 group-hover:text-gold">+</span>
            </div>
            <p class="mt-6 font-body text-xs font-semibold uppercase tracking-widest text-ink group-hover:text-gold transition-colors">{cap.title}</p>
            <p class="mt-2 max-w-[200px] font-body text-[11px] leading-relaxed text-ink/60">{cap.short}</p>
          </a>
        ))}
      </div>
      <a href="/capabilities" class="mt-20 inline-block bg-ink px-8 py-3.5 font-body text-xs font-semibold uppercase tracking-wider text-ivory hover:bg-gold transition-colors">
        View All Capabilities
      </a>
    </div>
  </section>

  <!-- 07. INSIDE THE TIMEPIECE -->
  <section class="bg-sand py-24 text-center border-t border-hairline">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Inside the Timepiece</h2>
      <div class="mt-12">
        <!-- Save your exploded watch view diagram as "exploded-watch.png" -->
        <img src="/exploded-watch.png" alt="Exploded Watch Diagram" class="w-full h-auto object-contain mx-auto mix-blend-multiply" />
      </div>
    </div>
  </section>

  <!-- 08. BRANDS -->
  <section class="bg-ivory">
    <div class="grid md:grid-cols-2">
      <!-- Aevum (Dark Block) -->
      <div class="relative flex min-h-[500px] flex-col items-center justify-center overflow-hidden bg-ink p-12 text-center text-ivory">
        <div class="absolute inset-0 opacity-40">
           <!-- Save as "aevum-bg.jpg" -->
           <img src="/aevum-bg.jpg" alt="Aevum" class="w-full h-full object-cover" />
        </div>
        <div class="relative z-10">
          <h3 class="font-display text-5xl tracking-wide">AEVUM</h3>
          <p class="mt-3 font-body text-xs uppercase tracking-[0.2em] text-gold-soft">Gold & Silver Timepieces</p>
          <a href="/our-brands/aevum" class="mt-10 inline-block border border-ivory/50 px-8 py-3 font-body text-[10px] uppercase tracking-widest hover:bg-ivory hover:text-ink transition-colors">Explore Aevum</a>
        </div>
      </div>
      
      <!-- Tarini925 (Light Block) -->
      <div class="relative flex min-h-[500px] flex-col items-center justify-center overflow-hidden bg-sand p-12 text-center text-ink border-l border-hairline">
        <div class="absolute inset-0 opacity-30 mix-blend-multiply">
           <!-- Save as "tarini-bg.jpg" -->
           <img src="/tarini-bg.jpg" alt="Tarini925" class="w-full h-full object-cover grayscale" />
        </div>
        <div class="relative z-10">
          <h3 class="font-display text-5xl tracking-wide">TARINI925</h3>
          <p class="mt-3 font-body text-xs uppercase tracking-[0.2em] text-ink/60">925 Silver Jewellery</p>
          <a href="/tarini925" class="mt-10 inline-block border border-ink/30 px-8 py-3 font-body text-[10px] uppercase tracking-widest hover:bg-ink hover:text-ivory transition-colors">Explore Tarini925</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 09. SELECTED PROJECTS -->
  <section class="bg-sand py-24 text-center border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Selected Projects</h2>
      <div class="mt-12 grid grid-cols-3 gap-4 md:gap-8">
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-1.jpg" class="w-full h-full object-cover"/></div>
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-2.jpg" class="w-full h-full object-cover"/></div>
        <div class="aspect-square bg-ivory rounded-sm overflow-hidden"><img src="/project-3.jpg" class="w-full h-full object-cover"/></div>
      </div>
    </div>
  </section>

  <!-- 10. FINAL CTA (Dark per wireframe) -->
  <section class="bg-ink py-32 text-center">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-display text-3xl leading-[1.2] text-ivory md:text-5xl">
        HAVE A TIMEPIECE IN MIND?<br/>LET'S TURN IT INTO REALITY.
      </h2>
      <a href="/start-a-project" class="mt-12 inline-block border border-gold bg-transparent px-10 py-4 font-body text-[11px] font-semibold uppercase tracking-[0.2em] text-ivory hover:bg-gold hover:text-ink transition-colors">
        Start a Project
      </a>
    </div>
  </section>
</Layout>