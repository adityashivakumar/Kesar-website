---
import Layout from "../../layouts/Layout.astro";
import { capabilities } from "../../lib/content";
---

<Layout title="Capabilities" description="Kesar's full suite of watchmaking capabilities.">
  <section class="bg-ivory py-32">
    <div class="mx-auto max-w-7xl px-6">
      <h1 class="text-center font-display text-5xl md:text-6xl mb-24">OUR CAPABILITIES</h1>
      
      <!-- Changed to 2 Columns -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        {capabilities.map((cap, index) => (
          <div class="group flex flex-col gap-8 border border-hairline p-8 hover:border-gold transition-colors">
            <!-- Increased Image Size -->
            <div class="w-full aspect-[4/3] bg-sand overflow-hidden">
              <img src={`/cap${index + 1}.jpg`} alt={cap.title} class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" />
            </div>
            
            <div class="flex-1">
              <h3 class="font-display text-3xl text-ink transition-colors group-hover:text-gold-deep mb-4">{cap.title}</h3>
              <p class="font-body text-sm leading-relaxed text-ink/70">{cap.detail || cap.short}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>