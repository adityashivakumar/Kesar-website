---
// src/pages/start-a-project.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Start a Project | Kesar" description="Begin your bespoke watchmaking commission.">
  <section class="bg-ivory py-32">
    <div class="mx-auto max-w-[1400px] px-6 md:px-12">
      <h1 class="font-display text-4xl md:text-5xl text-ink uppercase tracking-wide mb-16">
        Project Inquiry
      </h1>

      <form id="inquiry-form" action="/send-mail.php" method="POST" class="grid grid-cols-1 lg:grid-cols-12 gap-16">
        
        <!-- Left Column: Form Inputs -->
        <div class="lg:col-span-8 space-y-8">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <label class="block font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 mb-2">Name *</label>
              <input type="text" name="name" required class="w-full bg-transparent border-b border-hairline py-3 font-body text-ink focus:outline-none focus:border-ink transition-colors" placeholder="Your name" />
            </div>
            <div>
              <label class="block font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 mb-2">Company</label>
              <input type="text" name="company" class="w-full bg-transparent border-b border-hairline py-3 font-body text-ink focus:outline-none focus:border-ink transition-colors" placeholder="Company name (optional)" />
            </div>
          </div>

          <div>
            <label class="block font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 mb-2">Email *</label>
            <input type="email" name="email" required class="w-full bg-transparent border-b border-hairline py-3 font-body text-ink focus:outline-none focus:border-ink transition-colors" placeholder="name@example.com" />
          </div>

          <div>
            <label class="block font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 mb-2">Project Type</label>
            <select name="project_type" class="w-full bg-transparent border-b border-hairline py-3 font-body text-ink focus:outline-none focus:border-ink transition-colors">
              <option value="" disabled selected>Select...</option>
              <option value="Bespoke Watchmaking">Bespoke Watchmaking</option>
              <option value="Precious Metal Timepiece">Precious Metal Timepiece</option>
              <option value="Component Manufacturing">Component Manufacturing</option>
              <option value="Tarini925 Jewellery">Tarini925 Jewellery</option>
            </select>
          </div>

          <div>
            <label class="block font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/70 mb-2">Project Details</label>
            <textarea name="project_details" rows="4" class="w-full bg-transparent border-b border-hairline py-3 font-body text-ink focus:outline-none focus:border-ink transition-colors resize-none" placeholder="Tell us about your project..."></textarea>
          </div>

          <div class="pt-4">
            <button type="submit" id="submit-btn" class="border border-ink bg-ink px-10 py-4 font-body text-sm font-semibold uppercase tracking-widest text-ivory hover:bg-transparent hover:text-ink transition-all">
              Submit Inquiry
            </button>
            <p id="form-status" class="mt-4 font-body text-sm text-ink/70"></p>
          </div>

        </div>

        <!-- Right Column: Direct Contact info -->
        <div class="lg:col-span-4 bg-sand p-10 border border-hairline h-fit flex flex-col items-center text-center space-y-8">
          <div>
            <h3 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 mb-2">Prefer to talk?</h3>
            <p class="font-body text-sm text-ink/70">Reach our team directly.</p>
          </div>
          <a href="mailto:hello@kesardesigns.com" class="font-display text-lg text-ink hover:underline">hello@kesardesigns.com</a>
        </div>

      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const statusMsg = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    
    if (statusMsg) {
      statusMsg.textContent = "Sending inquiry...";
      statusMsg.style.color = "#666";
    }

    try {
      const response = await fetch('/send-mail.php', {
        method: 'POST',
        body: formData
      });
      const result = await response.json();

      if (response.ok && result.status === 'success') {
        if (statusMsg) {
          statusMsg.textContent = "Thank you! Your inquiry has been sent to hello@kesardesigns.com.";
          statusMsg.style.color = "green";
        }
        form.reset();
      } else {
        throw new Error(result.message || 'Something went wrong.');
      }
    } catch (error) {
      if (statusMsg) {
        statusMsg.textContent = "Error sending message. Please email us directly at hello@kesardesigns.com";
        statusMsg.style.color = "red";
      }
    }
  });
</script>