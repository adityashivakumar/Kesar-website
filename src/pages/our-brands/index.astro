---
// src/pages/our-brands/index.astro
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Our Brands" description="Kesar's own brands.">
  
  <section class="bg-ivory py-32 text-center border-b border-hairline">
    <div class="mx-auto max-w-4xl px-6">
      <h1 class="font-display text-5xl md:text-6xl text-ink tracking-wide">OUR BRANDS</h1>
      <p class="mt-6 font-body text-lg leading-relaxed text-ink/70">
        Aevum and Tarini925 are direct products of the same precious-metal expertise Kesar brings to its B2B watchmaking work.
      </p>
    </div>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-2">
    
    <div class="relative flex flex-col items-center justify-center p-12 md:p-24 bg-ink text-ivory group overflow-hidden min-h-[75vh]">
      <img src="/aevum-hero.jpg" alt="Aevum" class="absolute inset-0 w-full h-full object-cover opacity-40 transition-transform duration-1000 group-hover:scale-105" />
      
      <div class="relative z-10 text-center flex flex-col items-center">
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-gold-soft mb-4">Watches</p>
        <h2 class="font-display text-5xl md:text-7xl tracking-widest mb-6">AEVUM</h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-ivory/70 max-w-md mb-10">
          Kesar's own gold and silver watch brand. Built around the character, weight, and beauty of precious metal timepieces.
        </p>
        <a href="/our-brands/aevum" class="border border-ivory px-10 py-4 font-body text-sm font-semibold uppercase tracking-widest hover:bg-ivory hover:text-ink transition-colors">
          Explore Aevum
        </a>
      </div>
    </div>

    <div class="relative flex flex-col items-center justify-center p-12 md:p-24 bg-sand text-ink group overflow-hidden min-h-[75vh]">
      <img src="/tarini-hero.jpg" alt="Tarini925" class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale mix-blend-multiply transition-transform duration-1000 group-hover:scale-105" />
      
      <div class="relative z-10 text-center flex flex-col items-center">
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 mb-4">Jewellery</p>
        <h2 class="font-display text-5xl md:text-7xl tracking-widest mb-6">TARINI925</h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-ink/70 max-w-md mb-10">
          Kesar's own 925 silver jewellery brand, for direct and B2B customers. Developed with the same precious-metal craftsmanship.
        </p>
        <a href="/tarini925" class="border border-ink px-10 py-4 font-body text-sm font-semibold uppercase tracking-widest hover:bg-ink hover:text-ivory transition-colors">
          Explore Tarini925
        </a>
      </div>
    </div>

  </section>
</Layout>