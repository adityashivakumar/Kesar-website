---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About Kesar | High-End Watch Developer"
  description="India’s high-end watch developer in precious metal & high-end materials."
>
  <!-- 01. HERO SECTION -->
  <section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden bg-ink text-center py-32">
    <div class="absolute inset-0 z-0">
      <img src="/workshop.jpg" alt="About Kesar" class="w-full h-full object-cover opacity-40" />
      <div class="absolute inset-0 bg-ink/50 z-10"></div>
    </div>
    <div class="relative z-20 mx-auto max-w-4xl px-6">
      <span class="font-body text-xs font-semibold uppercase tracking-[0.3em] text-gold-soft mb-4 block">About Us</span>
      <h1 class="animate-rise font-display text-3xl leading-tight text-ivory md:text-5xl tracking-wide uppercase">
        India’s high-end watch developer in precious metal & high-end materials
      </h1>
    </div>
  </section>

  <!-- 02. OUR STORY -->
  <section class="bg-ivory py-32">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 md:grid-cols-2">
      <div>
        <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-8">
          Our Story
        </h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-ink/70 mb-6">
          From original concept, initial sketch, to the crafting of every tiny part, through countless iterations of refinement and adjustment, to the final assembly.
        </p>
        <p class="font-body text-base md:text-lg leading-relaxed text-ink/70">
          KESAR Watch Designs' journey has been built around a simple objective: to connect design, manufacturing, product development, and market opportunities under one ecosystem.
        </p>
      </div>
      <div class="aspect-[4/3] bg-sand overflow-hidden border border-hairline group">
        <img src="/workshop.jpg" alt="Kesar Workshop Craftsmanship" class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" />
      </div>
    </div>
  </section>

  <!-- 03. OUR PHILOSOPHY -->
  <section class="bg-sand py-32 border-t border-hairline text-center">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-20 max-w-xs mx-auto">
        Our Philosophy
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
        <div class="flex flex-col items-center">
          <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-hairline bg-ivory shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ink/80">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink mb-4">People</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            Master watchmakers, engineers, and designers dedicated to the relentless pursuit of perfection.
          </p>
        </div>

        <div class="flex flex-col items-center">
          <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-hairline bg-ivory shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ink/80">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
            </svg>
          </div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink mb-4">Material</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            An uncompromising commitment to precious metals—treating gold and silver not as accents, but as the foundation.
          </p>
        </div>

        <div class="flex flex-col items-center">
          <div class="mb-8 flex h-16 w-16 items-center justify-center rounded-full border border-hairline bg-ivory shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-ink/80">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-[0.2em] text-ink mb-4">Purpose</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            Creating timepieces that outlast trends, engineered to be passed down through generations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04. OUR JOURNEY (Timeline) -->
  <section class="bg-ivory py-32 border-t border-hairline">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-20 text-center max-w-xs mx-auto">
        Our Journey
      </h2>

      <div class="relative border-l border-hairline ml-4 md:ml-32 space-y-16">
        
        <!-- Timeline Item 1 -->
        <div class="relative pl-8 md:pl-16">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-deep"></div>
          <div class="md:absolute md:-left-32 md:top-1 font-display text-3xl text-ink">2024</div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Stainless Steel Foundation</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            Developed capabilities in 316L stainless-steel watch case manufacturing, particularly for automatic watches. This became an important foundation for KESAR's subsequent development in the watch industry.
          </p>
        </div>

        <!-- Timeline Item 2 -->
        <div class="relative pl-8 md:pl-16">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-deep"></div>
          <div class="md:absolute md:-left-32 md:top-1 font-display text-3xl text-ink">2025</div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">First Premium Partnership</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            KESAR expanded beyond conventional stainless-steel watch development and entered into its first significant premium product partnership encompassing Precious Metal + Fine Jewellery + Watchmaking + Design + Manufacturing.
          </p>
        </div>

        <!-- Timeline Item 3 -->
        <div class="relative pl-8 md:pl-16">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-deep"></div>
          <div class="md:absolute md:-left-32 md:top-1 font-display text-3xl text-ink">2025</div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Complete Assembly Solution</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            KESAR further expanded its capabilities from component and case development into complete watch assembly. The focus increasingly shifted towards providing customers with a design-to-finished-watch solution.
          </p>
        </div>

        <!-- Timeline Item 4 -->
        <div class="relative pl-8 md:pl-16">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-deep"></div>
          <div class="md:absolute md:-left-32 md:top-1 font-display text-3xl text-ink">2026</div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Tarini925 Launch</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            Entered the 925-silver jewellery segment through the development of the TARINI925 brand. This expansion strengthened KESAR's capabilities in the jewellery ecosystem and created an opportunity to develop products not only for customers but also as independent brands.
          </p>
        </div>

        <!-- Timeline Item 5 -->
        <div class="relative pl-8 md:pl-16">
          <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-gold-deep"></div>
          <div class="md:absolute md:-left-32 md:top-1 font-display text-3xl text-ink">2026</div>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Aevum & Silver Watches</h3>
          <p class="font-body text-base text-ink/70 leading-relaxed">
            Alongside the jewellery initiative, KESAR expanded into 925 silver watches, including the development of AEVUM. This represents KESAR's continued movement towards premium product creation rather than only component manufacturing.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 05. SUSTAINABILITY -->
  <section class="bg-sand py-32 border-t border-hairline">
    <div class="mx-auto grid max-w-7xl items-center gap-16 px-6 md:grid-cols-2">
      <div class="aspect-[4/3] bg-ivory overflow-hidden border border-hairline group">
        <img src="/workshop.jpg" alt="Sustainability at Kesar" class="w-full h-full object-cover grayscale mix-blend-multiply transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" />
      </div>
      <div>
        <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 mb-8">
          Sustainability
        </h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-ink/70">
          We believe that true luxury does not come at the expense of the environment. Kesar is committed to responsible sourcing, minimizing manufacturing waste, and developing processes that respect both the craftsman and the world we share.
        </p>
      </div>
    </div>
  </section>

  <!-- 06. CAPABILITIES GRID (Redesigned) -->
  <section class="bg-ivory py-32 border-t border-hairline">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <h2 class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/50 border-b border-hairline pb-4 max-w-xs mx-auto mb-4">
          Our Capabilities
        </h2>
        <p class="font-display text-2xl md:text-4xl text-ink uppercase tracking-wide">
          End-to-End Watchmaking Ecosystem
        </p>
      </div>

      <!-- Capability Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        
        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">01</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Watch Design</h3>
          <p class="font-body text-sm text-ink/70">Original concepts, technical pen sketching, and 3D CAD form exploration.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">02</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Product Development</h3>
          <p class="font-body text-sm text-ink/70">Prototyping, CMF design, engineering, and iterative refinement.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">03</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Manufacturing</h3>
          <p class="font-body text-sm text-ink/70">Precious metals, high-grade materials, and precision case fabrication.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">04</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Component Sourcing</h3>
          <p class="font-body text-sm text-ink/70">Curating dials, movements, straps, and high-end hardware.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">05</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Precision Assembly</h3>
          <p class="font-body text-sm text-ink/70">Swiss-standard movement casing, dial mounting, and quality control.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">06</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">OEM / ODM</h3>
          <p class="font-body text-sm text-ink/70">Comprehensive white-label and custom manufacturing solutions for brands.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">07</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Custom Development</h3>
          <p class="font-body text-sm text-ink/70">Tailored bespoke timepieces engineered to precise client specifications.</p>
        </div>

        <div class="bg-sand/50 p-8 border border-hairline hover:border-ink/40 transition-all group">
          <span class="font-display text-xs text-ink/40 block mb-4">08</span>
          <h3 class="font-body text-sm font-semibold uppercase tracking-wider text-ink mb-2">Ecosystem Solutions</h3>
          <p class="font-body text-sm text-ink/70">Bridging creative vision, manufacturing, and independent brand realization.</p>
        </div>

      </div>

      <div class="text-center">
        <a href="/capabilities" class="inline-block border border-ink px-10 py-4 font-body text-sm font-semibold uppercase tracking-widest text-ink hover:bg-ink hover:text-ivory transition-colors">
          Explore Full Capabilities
        </a>
      </div>
    </div>
  </section>

  <!-- 07. FINAL CTA -->
  <section class="bg-ink py-32 text-center border-t border-hairline">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-display text-3xl leading-[1.2] text-ivory md:text-5xl tracking-wide uppercase">
        Have a timepiece in mind?
      </h2>
      <a href="/start-a-project" class="mt-12 inline-block border border-gold bg-transparent px-10 py-4 font-body text-sm font-semibold uppercase tracking-[0.2em] text-ivory hover:bg-gold hover:text-ink transition-colors">
        Start a Project
      </a>
    </div>
  </section>
</Layout>