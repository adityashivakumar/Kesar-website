---
// src/components/Footer.astro
---

<footer class="bg-[#050505] text-ivory border-t border-white/10 pt-24 pb-16 overflow-hidden">
  <div class="mx-auto max-w-[1600px] px-6 md:px-12">
    
    <!-- Top Editorial Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-20 pb-20 border-b border-white/10">
      
      <!-- Brand Statement (Col 5) -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <h2 class="font-display text-3xl md:text-4xl tracking-widest text-white mb-6 uppercase">
            Kesar
          </h2>
          <p class="font-body text-sm md:text-base leading-relaxed text-ivory/70 max-w-md">
            Precious-metal watchmaking and product development, from first idea through to finished timepiece. Built on craft, driven by possibility.
          </p>
        </div>
        
        <div class="mt-10 hidden md:block">
          <a href="/start-a-project" class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-gold-soft hover:text-white transition-colors">
            <span>Begin Your Commission</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Navigation Links Grid (Col 7 split into 3 columns) -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        
        <!-- Site Links -->
        <div>
          <h3 class="font-body text-[11px] font-semibold uppercase tracking-[0.25em] text-gold-soft mb-6">
            Navigation
          </h3>
          <ul class="space-y-4 font-body text-sm tracking-wide">
            <li><a href="/precious-metal" class="text-ivory/70 hover:text-white transition-colors">Precious Metal</a></li>
            <li><a href="/capabilities" class="text-ivory/70 hover:text-white transition-colors">Capabilities</a></li>
            <li><a href="/our-brands" class="text-ivory/70 hover:text-white transition-colors">Our Brands</a></li>
            <li><a href="/about" class="text-ivory/70 hover:text-white transition-colors">About</a></li>
          </ul>
        </div>

        <!-- Brands Links -->
        <div>
          <h3 class="font-body text-[11px] font-semibold uppercase tracking-[0.25em] text-gold-soft mb-6">
            Atelier Brands
          </h3>
          <ul class="space-y-4 font-body text-sm tracking-wide">
            <li><a href="/our-brands/aevum" class="text-ivory/70 hover:text-white transition-colors">Aevum</a></li>
            <li><a href="/tarini925" class="text-ivory/70 hover:text-white transition-colors">Tarini925</a></li>
          </ul>
        </div>

        <!-- Contact & Enquiries -->
        <div class="col-span-2 sm:col-span-1">
          <h3 class="font-body text-[11px] font-semibold uppercase tracking-[0.25em] text-gold-soft mb-6">
            Direct
          </h3>
          <ul class="space-y-4 font-body text-sm tracking-wide">
            <li><a href="/start-a-project" class="text-ivory/70 hover:text-white transition-colors">Start a Project</a></li>
            <li><a href="mailto:designs@kesardesigns.com" class="text-ivory/70 hover:text-white transition-colors break-all">designs@kesardesigns.com</a></li>
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom Copyright & Parent Attribution -->
    <div class="pt-10 flex flex-col sm:flex-row justify-between items-center text-xs font-body tracking-[0.1em] text-ivory/40 gap-4">
      <p>© 2026 Kesar. All rights reserved.</p>
      <p class="uppercase text-[10px] tracking-[0.2em] text-gold-soft/60">Parent company of Aevum and Tarini925.</p>
    </div>

  </div>
</footer>